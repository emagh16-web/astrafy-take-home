with orders as (

    select
        order_date,
        customer_id,
        order_id,
        net_sales
    from {{ ref('stg_orders') }}
    where extract(year from order_date) = 2026

),

segmentation as (

    select
        order_id,
        order_segmentation
    from {{ ref('exercise_5_order_segmentation_2026') }}

)

select
    orders.order_date,
    orders.customer_id,
    orders.order_id,
    orders.net_sales,
    segmentation.order_segmentation
from orders
left join segmentation
    on orders.order_id = segmentation.order_id